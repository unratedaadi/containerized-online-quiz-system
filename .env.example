# Local presentation mode. Demo accounts are shared and have full demo access.
DEMO_MODE=true
PORT=3001
DB_PATH=data/quizroom.sqlite
COOKIE_SECURE=false
# Optional private admin provisioning; use at least 12 password characters.
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Backend only. Obtain matching app token/verifier from your own Edge Function setup.
# SUPABASE_LEADERBOARD_URL=https://your-project.supabase.co/functions/v1/leaderboard
# QUIZROOM_SYNC_TOKEN=
